# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=sqlite:///./healthtwin.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with this placeholder or a short value.
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-generated-fernet-key
# Optional, for key rotation: old keys, comma separated. They can still decrypt.
FERNET_OLD_KEYS=
PASSPORT_TOKEN_EXPIRE_MINUTES=30
ESCALATION_TIMEOUT_SECONDS=30
DEMO_MODE=true
