# Copy to .env to point the app at a different server. Default is the mock server.
# One variable switches everything: the WebSocket address is built from it (http -> ws).
VITE_API_URL=http://localhost:4000
# Optional: set only if the live-events server is at a different address.
# VITE_WS_URL=ws://localhost:4000/ws

# The public address of this app. Used to build the link inside the health passport QR code.
# Leave it out in development (the current address is used). Set it when deployed, e.g. https://healthtwin.example.app
# VITE_APP_URL=http://localhost:5173

# Rehearsal tools (/demo panel, simulated fall/offline, speed). Leave OFF in anything you deploy for real users.
# VITE_DEMO_TOOLS=true
