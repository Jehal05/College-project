{
  "_note": "Every endpoint and WebSocket event the hospital portal uses. 'agreed' = in the team plan PDF. 'proposed' = added by Puneet, must be confirmed with Daksh before the demo.",
  "rest": [
    { "method": "POST", "path": "/auth/login", "used_for": "Log in, returns token and role", "status": "agreed" },
    { "method": "GET", "path": "/hospitals?lat&lng&type", "used_for": "Hospital list for the map and ranking", "status": "agreed" },
    { "method": "PATCH", "path": "/hospitals/{id}/availability", "used_for": "Beds, ICU, cath lab, stroke unit form", "status": "agreed" },
    { "method": "GET", "path": "/emergencies/{id}", "used_for": "Details and timeline", "status": "agreed" },
    { "method": "POST", "path": "/emergencies/{id}/ack", "used_for": "Acknowledge an alert", "status": "agreed" },
    { "method": "POST", "path": "/emergencies/{id}/dispatch", "used_for": "Dispatch an ambulance (body: ambulance_id)", "status": "agreed" },
    { "method": "POST", "path": "/emergencies/{id}/status", "used_for": "EN_ROUTE, ARRIVED, HANDOVER_DONE", "status": "agreed" },
    { "method": "POST", "path": "/ambulances/{id}/location", "used_for": "Ambulance position and ETA each second", "status": "agreed" },
    { "method": "GET", "path": "/emergencies?status=active", "used_for": "Alert queue on login", "status": "proposed" },
    { "method": "GET", "path": "/emergencies?status=finished", "used_for": "Case history and analytics (must include status_events)", "status": "proposed" },
    { "method": "PATCH", "path": "/emergencies/{id}/checklist", "used_for": "Tick a pre-arrival checklist item", "status": "proposed" },
    { "method": "GET", "path": "/ambulances", "used_for": "Fleet list", "status": "proposed" },
    { "method": "POST", "path": "/emergencies/{id}/notes", "used_for": "Timeline notes: assignment, corridor, pickup, responder alert", "status": "proposed" },
    { "method": "POST", "path": "/emergencies/{id}/chat", "used_for": "Desk and crew chat", "status": "proposed" },
    { "method": "POST", "path": "/hospitals", "used_for": "Onboard a hospital (saved unverified)", "status": "proposed" },
    { "method": "PUT", "path": "/hospitals/{id}", "used_for": "Edit hospital details", "status": "proposed" },
    { "method": "PATCH", "path": "/hospitals/{id}/verify", "used_for": "Admin verifies a hospital (body: verified)", "status": "proposed" }
  ],
  "events": [
    { "name": "emergency.created", "used_for": "New alert in the queue", "status": "agreed" },
    { "name": "emergency.cancelled", "used_for": "Patient pressed I'm OK", "status": "agreed" },
    { "name": "hospital.acknowledged", "used_for": "Alert acknowledged", "status": "agreed" },
    { "name": "hospital.escalated", "used_for": "Alert moved to the next hospital", "status": "agreed" },
    { "name": "ambulance.dispatched", "used_for": "Ambulance sent", "status": "agreed" },
    { "name": "ambulance.location", "used_for": "Moving marker; state EN_ROUTE on the first one", "status": "agreed" },
    { "name": "emergency.arrived", "used_for": "Ambulance arrived", "status": "agreed" },
    { "name": "emergency.handover_done", "used_for": "Handed over", "status": "agreed" },
    { "name": "emergency.note", "used_for": "Timeline note and extra fields", "status": "proposed" },
    { "name": "chat.message", "used_for": "Desk and crew chat message", "status": "proposed" }
  ],
  "other": [
    { "name": "WebSocket ?token=", "used_for": "Token passed in the WebSocket address", "status": "proposed" }
  ]
}
