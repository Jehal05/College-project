# Copy to .env and edit.
# true  = use local fake JSON (no backend needed)
# false = call Daksh's real backend
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Who moves the ambulance on the map? (simulated either way)
#   auto  (default) mock mode: the portal. Real mode: the portal only if the backend sends no ambulance.location within 3 s of Dispatch.
#   true  the portal always simulates the trip
#   false the portal never does; only backend positions move the ambulance
VITE_PORTAL_SIMULATES_AMBULANCE=auto

# How the WebSocket login token is sent (real mode).
#   query   (default) ws://host/ws?token=...
#   message the token is sent as the first message: {"type":"auth","token":"..."}. Needs Daksh to accept it.
VITE_WS_AUTH=query
